# ==============================================
# FinRAG Engine — .gitignore
# ==============================================

# --- Secrets (NEVER commit) ---
.env
.env.*
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Vector Store (large binary files — rebuild locally) ---
vector_store/
*.faiss
*.pkl

# --- Data (PDFs — may be large or confidential) ---
# Uncomment to ignore raw data:
# data/

# --- MLflow artifacts ---
mlruns/
mlartifacts/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*.DS_Store

# --- Logs ---
*.log
logs/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Docker ---
*.tar

data/*.pdf
fix_embeddings.py
vector_store/*.faiss
vector_store/*.pkl
